.popup-box {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;

    background-color: rgba(0, 0, 0, 0.65);
}

.popup-box__panel {
    width: 70%;
    max-height: 80%;

    flex-shrink: 1;
    flex-direction: column;

    padding: 30px;

    background-color: rgba(0, 0, 0, 0.95);
}

.popup-box__title {
    align-self: stretch;
    flex-shrink: 0;

    margin-top: -30px;
    margin-left: -30px;
    margin-right: -30px;
    margin-bottom: 20px;

    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 35px;
    padding-right: 35px;

    background-color: white;
    color: black;

    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.popup-box__scroll-view {
    min-height: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.popup-box__content {
    flex-direction: column;
    flex-shrink: 0;
}

.popup-box__description {
    margin-bottom: 20px;

    color: white;
    font-size: 20px;
    white-space: normal;
}

.popup-box__buttons {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
    flex-shrink: 0;

    margin-top: 20px;
}

.popup-box__button {
    margin-left: 10px;
    margin-top: 5px;
    border-width: 0px;

    background-color: rgba(255, 255, 255, 0.02);

    color: white;
    font-size: 20px;

    transition-property: background-color, color;
    transition-duration: 0.1s;
    transition-timing-function: ease;
}

.popup-box__button:hover {
    color: black;

    background-color: rgba(255, 255, 255, 1);
}