.popup-box {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;

    background-color: rgba(0, 0, 0, 0.65);
}

.popup-box__panel {
    width: 70%;
    max-height: 80%;

    flex-shrink: 1;
    flex-direction: column;

    padding: 30px;

    background-color: rgba(0, 0, 0, 0.95);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgba(255, 255, 255, 0.5);
    border-right-color: rgba(255, 255, 255, 0.5);
    border-top-color: rgba(255, 255, 255, 0.5);
    border-bottom-color: rgba(255, 255, 255, 0.5);
}

.popup-box__title {
    flex-shrink: 0;
    margin-bottom: 20px;

    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
}

.popup-box__scroll-view {
    min-height: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.popup-box__content {
    flex-direction: column;
    flex-shrink: 0;
}

.popup-box__description {
    margin-bottom: 20px;

    color: white;
    font-size: 20px;
    white-space: normal;
}

.popup-box__buttons {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
    flex-shrink: 0;

    margin-top: 20px;
}

.popup-box__button {
    margin-left: 10px;
    margin-top: 5px;
}