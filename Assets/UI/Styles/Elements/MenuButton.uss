
.menu-button {
    width: 85%;
    min-height: 64px;

    background-color: rgba(0, 0, 0, 0.75);
    background-image: none;
    color: white;

    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 0;

    -unity-text-align: middle-center;
}

.menu-button__stripe {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;

    background-color: white;
}
