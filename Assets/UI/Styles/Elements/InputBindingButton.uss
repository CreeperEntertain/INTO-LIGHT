.input-binding-button {
    position: relative;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    min-height: 44px;

    padding: 20px;
    margin: 0px;

    background-color: rgba(0, 0, 0, 0);
    background-image: none;

    border-width: 0;
}

.input-binding-button__name {
    flex-grow: 1;
    flex-shrink: 1;

    color: white;
    font-size: 24px;
    -unity-text-align: upper-left;
    align-self: flex-start;
}

.input-binding-button__visual {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.input-binding-button__outline {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);

    background-color: rgba(0, 0, 0, 0);

    transition-property: border-width;
    transition-duration: 0.2s;
    transition-timing-function: ease;
}

.input-binding-button:hover .input-binding-button__outline {
    border-width: 5px;
}

.input-binding-button__key-cluster {
    width: 60px;

    flex-direction: column;
    flex-shrink: 0;
}

.input-binding-button__key-row {
    width: 60px;
    height: 18px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.input-binding-button__key-row--second {
    margin-top: 3px;
}

.input-binding-button__key,
.input-binding-button__key-placeholder {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.input-binding-button__key {
    background-color: white;
    color: black;

    font-size: 10px;
    -unity-text-align: middle-center;
}

.input-binding-button__icon {
    width: 28px;
    height: 28px;

    flex-shrink: 0;
}