.unity-scroll-view__vertical-scroller {
    width: 10px;
}

.unity-scroll-view__horizontal-scroller {
    height: 10px;
}

.unity-scroll-view .unity-scroller__low-button,
.unity-scroll-view .unity-scroller__high-button {
    width: 0px;
    height: 0px;
    display: none;
}

.unity-scroll-view .unity-base-slider__tracker {
    background-color: rgba(127, 127, 127, 0.85);
    border-width: 0;
}

.unity-scroll-view .unity-base-slider__dragger {
    background-color: white;
    border-width: 0;
    border-radius: 0;
}