    scale: 2
    cullMotionBounds: 0
    motionSensitivity: {x: 1, y: 1}
    useComposite: 1
    up: <Keyboard>/w
    down: <Keyboard>/s
    left: <Keyboard>/a
    right: <Keyboard>/d
  jumpBindings:
