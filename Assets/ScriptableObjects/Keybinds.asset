  m_Script: {fileID: 11500000, guid: f01b02315f8408741b35e1d188583c20, type: 3}
  m_Name: Keybinds
  m_EditorClassIdentifier: Assembly-CSharp::PlayerInput
  moveBindings:
  - binding: <Gamepad>/leftStick
    mode: 0
    center: {x: 0.5, y: 0.5}
    scale: 2
    useComposite: 0
    up: 
    down: 
    left: 
    right: 
  - binding: 
    mode: 0
    center: {x: 0.5, y: 0.5}
    scale: 2
    useComposite: 1
    up: <Keyboard>/w
    down: <Keyboard>/s
    left: <Keyboard>/a
    right: <Keyboard>/d
  jumpBindings:
  - <Keyboard>/space
  - <Mouse>/middleButton
  - <Gamepad>/buttonSouth
  moveCamera:
  - binding: <Mouse>/delta
    mode: 1
    center: {x: 0.5, y: 0.5}
    scale: 2
    useComposite: 0
    up: 
    down: 
    left: 
    right: 
  - binding: <Gamepad>/rightStick
    mode: 0
    center: {x: 0.5, y: 0.5}
    scale: 2
    useComposite: 0
    up: 
    down: 
    left: 
    right: 
  - binding: 
    mode: 0
    center: {x: 0.5, y: 0.5}
    scale: 2
    useComposite: 1
    up: <Keyboard>/upArrow
    down: <Keyboard>/downArrow
    left: <Keyboard>/leftArrow
    right: <Keyboard>/rightArrow
  handModeBindings:
  - <Keyboard>/leftAlt
  - <Mouse>/rightButton
  - <Gamepad>/leftShoulder
  resetMotionCalibration:
  - binding: <Gamepad>/start
    pressTime: 1
  moveHand:
  - binding: <Mouse>/delta
    mode: 1
    center: {x: 0.5, y: 0.5, z: 0.5}
    scale: 2
    useComposite: 0
    up: 
    down: 
    left: 
    right: 
    forward: 
    backward: 
  - binding: 
    mode: 3
    center: {x: 0.5, y: 0.5, z: 0.5}
    scale: 2
    useComposite: 0
    up: 
    down: 
    left: 
    right: 
    forward: 
    backward: 
  - binding: 
    mode: 0
    center: {x: 0.5, y: 0.5, z: 0.5}
    scale: 2
    useComposite: 1
    up: <Keyboard>/upArrow
    down: <Keyboard>/downArrow
    left: <Keyboard>/leftArrow
    right: <Keyboard>/rightArrow
    forward: 
    backward: 
  grabBindings:
  - <Mouse>/leftButton
  - <Keyboard>/leftCtrl
  - <Gamepad>/rightTrigger
  pose1Bindings:
